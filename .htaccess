# Sea College Dive Club — Apache / Hostinger (LiteSpeed) rules
DirectoryIndex index.php
Options -Indexes
ErrorDocument 404 /404.php
AddDefaultCharset UTF-8

<IfModule LiteSpeed>
  GeoIPEnable On
</IfModule>
<IfModule mod_geoip.c>
  GeoIPEnable On
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force single-hop canonical non-www HTTPS on production (matches Google Ads Final URL https://seacollegediveclub.com/)
  RewriteCond %{HTTP_HOST} ^www\.seacollegediveclub\.com$ [NC]
  RewriteRule ^ https://seacollegediveclub.com%{REQUEST_URI} [L,R=301]

  # Force HTTPS on all other hosts
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Dynamic sitemap, robots, AI/AEO llms.txt & Meta/Google product catalog feeds
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^(?:\.well-known/)?llms\.txt$ llms.php [L,QSA]
  RewriteRule ^(?:\.well-known/)?llms-full\.txt$ llms.php?full=1 [L,QSA]
  RewriteRule ^feeds/meta-catalog\.xml$ feeds/meta_catalog.php [L,QSA]
  RewriteRule ^feeds/meta-catalog-i18n\.xml$ feeds/meta_catalog.php?mode=i18n [L,QSA]
  RewriteRule ^feeds/meta-catalog-(en|ru|it|pl|de|fr|ar|zh)\.xml$ feeds/meta_catalog.php?lang=$1 [L,QSA]
  RewriteRule ^feeds/google-dsa-page-feed\.csv$ feeds/google_dsa_feed.php [L,QSA]
  RewriteRule ^feeds/google-ad-customizer\.csv$ feeds/google_ad_customizer.php [L,QSA]
  RewriteRule ^feeds/google-ad-customizer-(en|ru|it|pl|de|fr|ar|zh)\.csv$ feeds/google_ad_customizer.php?lang=$1 [L,QSA]

  # Never serve internal folders or dotfiles (backup to per-folder .htaccess)
  RewriteRule ^(config|includes|data|lang|storage|docs)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # Block unsupported HTTP methods (TRACE, TRACK, DELETE, PUT, PATCH, CONNECT)
  RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DELETE|PUT|PATCH|CONNECT)$ [NC]
  RewriteRule ^ - [F,L]

  # Block legacy WordPress / exploit scanner endpoints (xmlrpc, wp-admin, wp-login, phpmyadmin, shell probes)
  RewriteRule ^(wp-admin|wp-login\.php|wp-config\.php|xmlrpc\.php|wp-cron\.php|wp-json|phpmyadmin|pma|adminer|cgi-bin|vendor|node_modules)(/|$) - [F,L,NC]

  # Return HTTP 410 Gone on dead legacy WordPress paths & query bloat (?p=, ?page_id=, ?add-to-cart=, /wp-content/, /feed/) so Google de-indexes old WP bloat fast
  RewriteRule ^(wp-content|wp-includes|feed|comments/feed|author|wp-trackback\.php)(/|$) - [G,L,NC]
  RewriteCond %{QUERY_STRING} (^|&)(p|page_id|attachment_id|post_type|replytocom|add-to-cart|remove_item|wc-ajax)=[0-9a-zA-Z_%-]+ [NC]
  RewriteRule ^$ - [G,L]

  # WAF: Block SQLi, XSS, Directory Traversal, Null-Byte & Remote File Inclusion in query string
  RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|%2e%2e|%00|<script|%3cscript|union.*select|concat\(|benchmark\(|base64_encode|mosConfig|GLOBALS\[|_REQUEST\[|php://|data://|expect://) [NC]
  RewriteRule ^ - [F,L]

  # Prevent unauthorized third-party image/video hotlinking (allow empty referer, our domain, Google, Meta, Bing, Yandex, Tripadvisor)
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?seacollegediveclub\.com [NC]
  RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)?(hostingersite\.com|google\.[a-z.]+|bing\.com|yandex\.[a-z.]+|facebook\.com|instagram\.com|tripadvisor\.[a-z.]+|tiktok\.com|youtube\.com) [NC]
  RewriteRule ^assets/(images|videos)/.*\.(jpg|jpeg|png|webp|mp4)$ - [F,L,NC]

  # Google Tag Gateway (First-Party Mode -> *.fps.goog via allowlisted stateless proxy)
  RewriteRule ^s-(tm|aw|ga)(/.*)?$ handlers/gtg_proxy.php [E=no-gzip:1,L,QSA]

  # Fast-path static assets so images/CSS/JS never evaluate page rewrite regexes
  RewriteRule ^assets/ - [L]

  # Legacy WordPress & WooCommerce top-level pages / categories (301 + preserve ?gclid & UTMs via QSA)
  RewriteRule ^about-us/?$ /about [R=301,L,QSA]
  RewriteRule ^contact-us/?$ /contact [R=301,L,QSA]
  RewriteRule ^price-list/?$ /prices [R=301,L,QSA]
  RewriteRule ^(shop|store)/?$ /services [R=301,L,QSA]
  RewriteRule ^(cart|checkout)/?$ /prices [R=301,L,QSA]
  RewriteRule ^(terms-and-conditions|terms-conditions)/?$ /terms [R=301,L,QSA]
  RewriteRule ^privacy/?$ /privacy-policy [R=301,L,QSA]
  RewriteRule ^(site-dives|dive-sites)/?$ /dive-sites-sharm-el-sheikh [R=301,L,QSA]
  RewriteRule ^(courses|diving-courses)/?$ /diving-courses-sharm-el-sheikh [R=301,L,QSA]
  RewriteRule ^product-category/(courses|diving-courses|specialty-courses|learn-to-dive|go-pro|tuchen-kurse)(/.*)?$ /diving-courses-sharm-el-sheikh [R=301,L,QSA]
  RewriteRule ^(packages|packages-offers|offers)/?$ /padi-course-bundles-sharm-el-sheikh [R=301,L,QSA]
  RewriteRule ^product-category/(packages|offers|bundles)(/.*)?$ /padi-course-bundles-sharm-el-sheikh [R=301,L,QSA]
  RewriteRule ^(one-day-trip|daily-trips|diving-trips)/?$ /diving-trips-sharm-el-sheikh [R=301,L,QSA]
  RewriteRule ^product-category/(diving-trips|trips|daily-diving)(/.*)?$ /diving-trips-sharm-el-sheikh [R=301,L,QSA]
  RewriteRule ^(boats|snorkeling|private-boat)/?$ /snorkeling-and-boats-sharm-el-sheikh [R=301,L,QSA]
  RewriteRule ^product-category/(boats|snorkeling|private-boats)(/.*)?$ /snorkeling-and-boats-sharm-el-sheikh [R=301,L,QSA]

  # Draft / non-canonical single-service ad & widget slugs -> canonical catalog slugs (single-hop 301 + full QSA across all 8 langs)
  RewriteRule ^(?:en/)?courses/(?:padi-advanced-open-water-sharm|padi-advanced-open-water-sharm-el-sheikh|padi-advanced-open-water-diver-sharm)/?$ /courses/padi-advanced-open-water-diver-sharm-el-sheikh [R=301,L,QSA]
  RewriteRule ^(ru|it|pl|de|fr|ar|zh)/courses/(?:padi-advanced-open-water-sharm|padi-advanced-open-water-sharm-el-sheikh|padi-advanced-open-water-diver-sharm)/?$ /$1/courses/padi-advanced-open-water-diver-sharm-el-sheikh [R=301,L,QSA]

  RewriteRule ^(?:en/)?courses/padi-rescue-diver-sharm-el-sheikh/?$ /courses/padi-rescue-diver-course-sharm-el-sheikh [R=301,L,QSA]
  RewriteRule ^(ru|it|pl|de|fr|ar|zh)/courses/padi-rescue-diver-sharm-el-sheikh/?$ /$1/courses/padi-rescue-diver-course-sharm-el-sheikh [R=301,L,QSA]

  RewriteRule ^(?:en/)?courses/padi-enriched-air-nitrox-sharm/?$ /courses/padi-enriched-air-nitrox-sharm-el-sheikh [R=301,L,QSA]
  RewriteRule ^(ru|it|pl|de|fr|ar|zh)/courses/padi-enriched-air-nitrox-sharm/?$ /$1/courses/padi-enriched-air-nitrox-sharm-el-sheikh [R=301,L,QSA]

  RewriteRule ^(?:en/)?courses/padi-divemaster-sharm-el-sheikh/?$ /courses/padi-divemaster-internship-sharm-el-sheikh [R=301,L,QSA]
  RewriteRule ^(ru|it|pl|de|fr|ar|zh)/courses/padi-divemaster-sharm-el-sheikh/?$ /$1/courses/padi-divemaster-internship-sharm-el-sheikh [R=301,L,QSA]

  RewriteRule ^(?:en/)?courses/heros-bundle-owd-aowd-nitrox-sharm/?$ /courses/heros-bundle-open-water-advanced-nitrox [R=301,L,QSA]
  RewriteRule ^(ru|it|pl|de|fr|ar|zh)/courses/heros-bundle-owd-aowd-nitrox-sharm/?$ /$1/courses/heros-bundle-open-water-advanced-nitrox [R=301,L,QSA]

  RewriteRule ^(?:en/)?tours/(?:private-speed-boat-2-hours-sharm|private-speedboat-tiran-2-hours)/?$ /tours/tiran-island-private-speedboat-2-hours [R=301,L,QSA]
  RewriteRule ^(ru|it|pl|de|fr|ar|zh)/tours/(?:private-speed-boat-2-hours-sharm|private-speedboat-tiran-2-hours)/?$ /$1/tours/tiran-island-private-speedboat-2-hours [R=301,L,QSA]

  # Clean Google Ads & SEO Language Subdirectory URLs (/ru/..., /it/..., /pl/..., /de/..., /fr/..., /ar/..., /zh/..., /en/...)
  RewriteRule ^(en|ru|it|pl|de|fr|ar|zh)/?$ index.php?lang=$1 [L,QSA]
  RewriteRule ^(en|ru|it|pl|de|fr|ar|zh)/(services|prices|about|contact|privacy-policy|terms|thank-you|404)(\.php)?/?$ $2.php?lang=$1 [L,QSA]
  RewriteRule ^(en|ru|it|pl|de|fr|ar|zh)/check-in(\.php)?/?$ check-in.php?lang=$1 [L,QSA]
  RewriteRule ^(en|ru|it|pl|de|fr|ar|zh)/guides(\.php)?/?$ guides.php?lang=$1 [L,QSA]
  RewriteRule ^(en|ru|it|pl|de|fr|ar|zh)/guides/([a-z0-9-]+)/?$ guide.php?lang=$1&slug=$2 [L,QSA]
  RewriteRule ^(en|ru|it|pl|de|fr|ar|zh)/dive-sites-sharm-el-sheikh/?$ dive-sites.php?lang=$1 [L,QSA]
  RewriteRule ^(en|ru|it|pl|de|fr|ar|zh)/gallery(\.php)?/?$ gallery.php?lang=$1 [L,QSA]
  RewriteRule ^(en|ru|it|pl|de|fr|ar|zh)/(diving-trips-sharm-el-sheikh|diving-courses-sharm-el-sheikh|padi-course-bundles-sharm-el-sheikh|snorkeling-and-boats-sharm-el-sheikh)/?$ category.php?lang=$1&hub=$2 [L,QSA]
  RewriteRule ^(en|ru|it|pl|de|fr|ar|zh)/(tours|courses)/([a-z0-9-]+)/?$ item.php?lang=$1&section=$2&slug=$3 [L,QSA]
  RewriteRule ^(en|ru|it|pl|de|fr|ar|zh)/product/([a-z0-9-]+)/?$ item.php?lang=$1&legacy=$2 [L,QSA]

  # Clean top-level pages, Guides Hub/Articles, Check-In Portal, Internal ERP Mobile App, Dive Sites & Gallery (default English)
  RewriteRule ^(services|prices|about|contact|privacy-policy|terms|thank-you)/?$ $1.php [L,QSA]
  RewriteRule ^check-in/?$ check-in.php [L,QSA]
  RewriteRule ^app/?$ erp-app.php [L,QSA]
  RewriteRule ^guides/?$ guides.php [L,QSA]
  RewriteRule ^guides/([a-z0-9-]+)/?$ guide.php?slug=$1 [L,QSA]
  RewriteRule ^dive-sites-sharm-el-sheikh/?$ dive-sites.php [L,QSA]
  RewriteRule ^gallery/?$ gallery.php [L,QSA]

  # Category Hub SEO URLs (default English)
  RewriteRule ^(diving-trips-sharm-el-sheikh|diving-courses-sharm-el-sheikh|padi-course-bundles-sharm-el-sheikh|snorkeling-and-boats-sharm-el-sheikh)/?$ category.php?hub=$1 [L,QSA]

  # Individual Tour & PADI Course SEO/AEO pages (default English)
  RewriteRule ^(tours|courses)/([a-z0-9-]+)/?$ item.php?section=$1&slug=$2 [L,QSA]

  # Legacy WordPress/WooCommerce /product/<slug>/ 301 redirects
  RewriteRule ^product/([a-z0-9-]+)/?$ item.php?legacy=$1 [L,QSA]
  RewriteRule ^product/?$ /services [R=301,L,QSA]
</IfModule>

# Block source/data/backup/archive files (while allowing dynamic Google CSV ad feeds in /feeds/ and PWA manifest.json)
<FilesMatch "^(?!manifest\.json$|google-(dsa-page-feed|ad-customizer)(-(en|ru|it|pl|de|fr|ar|zh))?\.csv$).*\.(md|csv|log|sh|py|ini|lock|json|dist|gs|ipynb|sql|bak|old|orig|swp|env|yml|yaml|tar|gz|zip)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|README\.md)$">
  Require all denied
</FilesMatch>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/csv text/css application/javascript application/x-javascript text/javascript application/json image/svg+xml application/xml
</IfModule>

# Browser & CDN caching (assets are versioned with ?v=filemtime)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  SetEnvIf Query_String "(^|&)(gtm_debug|__gsa|tag_assistant)=" SC_TAG_ASSISTANT=1
  SetEnvIf Referer "^https://(tagassistant\.google\.com|ads\.google\.com|www\.googletagmanager\.com)(/|$)" SC_TAG_ASSISTANT=1
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups" env=!SC_TAG_ASSISTANT
  Header always set Cross-Origin-Opener-Policy "unsafe-none" env=SC_TAG_ASSISTANT
  Header unset X-Powered-By
  Header always unset X-Powered-By
  <FilesMatch "\.(css|js|mjs|jpg|jpeg|png|webp|avif|gif|svg|ico|woff|woff2|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
